# Copy to .env and fill in values. Never commit .env.

# --- Data warehouse (PostgreSQL) ---
DW_HOST=localhost
DW_USER=your_dw_user
DW_PASSWORD=your_dw_password

# --- Metadata catalog DB (PostgreSQL, bdw_rag_metadata) ---
# Often the same host as the DW; set explicitly if different.
METADATA_DB_HOST=localhost
METADATA_DB_USER=postgres
METADATA_DB_PASSWORD=your_metadata_password

# --- LLM (Generate SQL tab / generate_query only) ---
# Default provider is openai (see config/config.yaml llm.provider).
OPENAI_API_KEY=sk-your-key-here

# Local Ollama (optional). UI can switch OpenAI ↔ Local per request.
# base_url must include /v1 for the OpenAI-compatible API.
OLLAMA_BASE_URL=http://192.168.4.52:11434/v1
OLLAMA_MODEL=qwen3:8b

# --- Services ---
MCP_SERVER_PORT=3000
MCP_DEBUG=false
GRADIO_PORT=7860
GRADIO_SHARE=false
LOG_LEVEL=INFO
